<?xml version="1.0" encoding="utf-8"?>
<!-- The round entry point (manifest android:roundIcon). Identical layers to
     ic_launcher.xml: from API 26 the launcher owns the shape, so there is
     nothing round to say here — the difference only exists in the pre-26 PNGs,
     which do carry their own circular plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
