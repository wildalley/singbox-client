<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+ takes the icon from here and masks it to whatever shape the
     launcher uses; the mipmap-*dpi PNGs are the pre-26 fallback (minSdk is 24,
     so they still ship). <monochrome> is read only by API 33+ launchers with
     themed icons on, and ignored by everything older. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
