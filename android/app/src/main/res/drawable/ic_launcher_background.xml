<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background (API 26+). Full-bleed: the launcher masks it and
     may shift it for parallax, so nothing here may carry meaning by position.
     AppPalette.dark.bg with a quiet violet glow behind the ribbon artwork. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF080C12"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="54">
                <item android:offset="0" android:color="#386C40FF" />
                <item android:offset="1" android:color="#006C40FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
