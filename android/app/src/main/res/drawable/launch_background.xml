<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash. One file for every API level: minSdk is 24, so the
     template's drawable-v21/ twin could only ever have shadowed this one, and
     it has been removed rather than kept in sync.

     @color/splash_background resolves per uiMode (values/ and values-night/),
     which is what keeps the pre-first-frame window from flashing white in front
     of a dark app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
